rted_by_user": false, "restacked": false, "childrenSummary": "1 reply"}, {"id": 164379530, "body": "I got a pile of money and a 2nd had 2080ti waiting for AMD in November.", "body_json": null, "publication_id": 6349492, "post_id": 175660814, "user_id": 105221104, "ancestor_path": "", "type": "comment", "deleted": false, "date": "2022-09-23T20:13:30.527Z", "edited_at": "2022-09-23T20:13:51.975Z", "status": "published", "pinned_by_user_id": null, "restacks": 0, "name": "shark.", "photo_url": null, "handle": null, "reactor_names": [], "reaction": null, "reactions": {"❤": 3}, "reaction_count": 3, "children": [], "bans": [], "suppressed": false, "user_banned": false, "user_banned_for_comment": false, "user_slug": "105221104-shark", "metadata": {"is_author": false, "membership_state": null, "eligibleForGift": true}, "user_bestseller_tier": null, "can_dm": true, "userStatus": {"bestsellerTier": null, "subscriberTier": null, "leaderboard": null, "vip": false, "badge": null, "subscriber": null}, "score": 4, "children_count": 0, "reported_by_user": false, "restacked": false}], "_list_meta": {"post_date": "2022-09-23T18:16:12.434Z", "audience": "everyone"}}