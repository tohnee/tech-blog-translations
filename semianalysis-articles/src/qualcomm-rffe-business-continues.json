}, {"id": 164378718, "body": "Hi Dylan, thank you for the valuable insights into the ultraSAW and ultraBAW filters. I've been following Qualcomm closely for some time. In your article, you mentioned there remains several components in RFFE that Qualcomm is still not able to provide or is lacking in leadership. Which are some of these main components, and who are the respective leaders for each of those components - Skyworks, Broadcom, Qorvo, Murata etc? Thank you very much, much appreciated!", "body_json": null, "publication_id": 6349492, "post_id": 175660671, "user_id": 49562011, "ancestor_path": "", "type": "comment", "deleted": false, "date": "2021-10-23T06:45:04.242Z", "edited_at": null, "status": "published", "pinned_by_user_id": null, "restacks": 0, "name": "Douglas", "photo_url": "https://bucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com/public/images/76ab7fc8-1da8-48c7-9dcf-523ce10b8b39_144x144.png", "handle": "douglas582209", "reactor_names": [], "reaction": null, "reactions": {"❤": 0}, "reaction_count": 0, "children": [], "bans": [], "suppressed": false, "user_banned": false, "user_banned_for_comment": false, "user_slug": "douglas582209", "metadata": {"is_author": false, "membership_state": "subscribed", "eligibleForGift": false, "author_on_other_pub": {"name": "Douglas", "id": 4846014, "base_url": "https://douglas582209.substack.com"}}, "user_bestseller_tier": null, "can_dm": true, "userStatus": {"bestsellerTier": null, "subscriberTier": 1, "leaderboard": null, "vip": false, "badge": {"type": "subscriber", "tier": 1, "accent_colors": {"fg": {"light": {"r": 255, "g": 255, "b": 255, "a": 1}, "dark": {"r": 0, "g": 0, "b": 0, "a": 0.8}}, "bg": {"light": {"r": 233, "g": 155, "b": 59, "a": 1}, "dark": {"r": 248, "g": 168, "b": 72, "a": 1}}}}, "subscriber": null}, "score": 1, "children_count": 1, "reported_by_user": false, "restacked": false, "childrenSummary": "1 reply by Dylan Patel"}], "_list_meta": {"post_date": "2021-10-20T17:19:05.719Z", "aud